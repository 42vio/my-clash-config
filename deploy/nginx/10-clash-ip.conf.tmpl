# Managed by the local installer. Do not edit.
limit_req_zone $binary_remote_addr zone=publication:1m rate=2r/s;

# Generic TLS default server: every unmatched Host gets the same answer.
server {
    listen 8443 ssl default_server;
    listen [::]:8443 ssl default_server;
    server_name _;
    server_tokens off;

    ssl_certificate {{FULLCHAIN_PATH}};
    ssl_certificate_key {{PRIVKEY_PATH}};
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 1m;

    location / {
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;
        return 404;
    }
}

# Single literal-IP server: routing is by path only. Security headers
# stay scoped to the generic fallback so the panel application
# controls its own content policy.
server {
    listen 8443 ssl;
    listen [::]:8443 ssl;
    server_name {{PANEL_SERVER_NAME}};
    server_tokens off;

    ssl_certificate {{FULLCHAIN_PATH}};
    ssl_certificate_key {{PRIVKEY_PATH}};
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 1m;

    location {{PANEL_BASE_PATH}} {
        proxy_pass http://{{PANEL_UPSTREAM}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_hide_header Server;
        proxy_max_temp_file_size 0;
    }

    location /s/ {
        limit_req zone=publication burst=10 nodelay;
        client_max_body_size 1k;
        access_log off;
        proxy_pass http://{{PUBLISHER_UPSTREAM}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_hide_header Server;
        proxy_max_temp_file_size 0;
    }

    location / {
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;
        return 404;
    }
}
