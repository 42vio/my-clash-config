[Unit]
Description=Owner portal management task %i
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/clash-sub web-task %i
TimeoutStartSec=3600
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=null
StandardError=null
