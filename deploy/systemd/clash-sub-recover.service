[Unit]
Description=Recover interrupted Clash subscription runtime activation
DefaultDependencies=no
After=local-fs.target
Before=nginx.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/clash-sub recover
User=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/clash-sub/private /var/lib/clash-sub/public /etc/nginx/clash-sub /var/log/nginx /var/lib/nginx
