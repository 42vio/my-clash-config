# Managed by clash-sub install. Do not edit; regenerate via clash-sub install/update.
# Client IPs are not preserved across the stream hop (see stream.conf.j2); the
# rate-limit zones below are therefore effectively global — acceptable for a
# small private deployment. X-Forwarded-For is stripped in the panel block to
# prevent client-side spoofing.
limit_req_zone $binary_remote_addr zone=clash_subscription:10m rate=2r/s;
limit_req_zone $binary_remote_addr zone=clash_panel:10m rate=10r/s;

server {
    listen 127.0.0.1:30443 ssl;
    server_name sub.{{ domain }};
    server_tokens off;

    ssl_certificate {{ fullchain }};
    ssl_certificate_key {{ privkey }};
    ssl_protocols TLSv1.2 TLSv1.3;

    include {{ routes_include }};

{% if portal_enabled %}
    # Page capabilities and admin sessions are checked by the portal, never by JS.
    location ~ ^/(p/|admin/|clients/|portal-assets/) {
        access_log off;
        error_log /dev/null crit;
        log_not_found off;
        proxy_pass http://unix:/run/clash-sub/web.sock;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
        proxy_hide_header Server;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
        client_max_body_size 2k;
    }
{% endif %}

    # Prefer a favicon supplied by 3x-ui. Its HTML can also reference an icon
    # below the panel base path, which the panel proxy serves unchanged.
    location = /favicon.ico {
        access_log off;
{% if panel_public %}
        proxy_pass http://127.0.0.1:{{ panel_port }}/favicon.ico;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For "";
        proxy_hide_header Server;
        proxy_intercept_errors on;
        error_page 404 = /_clash-sub-favicon.ico;
{% else %}
        alias {{ favicon_path }};
{% endif %}
    }

    location = /_clash-sub-favicon.ico {
        internal;
        alias {{ favicon_path }};
        default_type image/x-icon;
        add_header Cache-Control "public, max-age=3600";
    }

    location = {{ panel_base_path }} {
        access_log off;
{% if panel_public %}
        return 308 {{ panel_base_path }}/;
{% else %}
        return 404;
{% endif %}
    }

    location ^~ {{ panel_base_path }}/ {
        access_log off;
{% if panel_public %}
        limit_req zone=clash_panel burst=20 nodelay;
        proxy_pass http://127.0.0.1:{{ panel_port }}{{ panel_base_path }}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_hide_header Server;
        proxy_max_temp_file_size 0;
{% else %}
        return 404;
{% endif %}
    }

    location ^~ /s/ {
        access_log off;
        log_not_found off;
        default_type "text/yaml; charset=utf-8";
        add_header X-Content-Type-Options nosniff always;
        add_header Cache-Control no-store always;
        return 404;
    }

    location / {
        access_log off;
        log_not_found off;
        return 404;
    }
}
