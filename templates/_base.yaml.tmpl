- {name: 自动选择, <<: *auto, exclude-filter: "流量|到期|剩余|官网|过期", icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Auto.png}
# - {name: 🚀 手动切换, <<: *usel, exclude-filter: "流量|到期|剩余|官网|过期"}

#功能分组
- {name: 游戏下载,       <<: *g1, icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Game.png}
- {name: SteamCN,      <<: *g1, icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Steam.png}
- {name: Steam,        <<: *g1, icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Steam.png}
- {name: BiliBili,     <<: *g2, icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/bilibili.png}
- {name: PT站加速,      <<: *g2, icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Media.png}
- {name: 国内流媒体,     <<: *g2, icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/DomesticMedia.png}
- {name: 国外流媒体,     <<: *g3, icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/ForeignMedia.png}
# - {name: Adobe,       <<: *sel, proxies: [🎯 Direct, REJECT]}
- {name: 苹果服务,      <<: *g1, icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Apple.png}
- {name: 微软服务,       <<: *g1, icon: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/icon/qure/color/Microsoft.png}
- {name: AI服务,        <<: *sel, proxies: [加速线路, 🇭🇰 香港节点], icon: https://raw.githubusercontent.com/Orz-3/mini/master/Color/OpenAI.png}
- {name: 测速工具,       <<: *g1, icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Speedtest.png}
- {name: 国外网站,       <<: *g3, icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Google_Search.png}
- {name: 隐私广告,       <<: *sel, proxies: [DIRECT, REJECT, 加速线路], icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Advertising.png}
- {name: 🐟 Final,    <<: *g3, icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Final.png}
- {name: 🎯 Direct,    <<: *sel, proxies: [DIRECT], icon: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/icon/qure/color/Direct.png}
- {name: 🇭🇰 香港节点,    <<: *auto, filter: "港|HK|(?i)Hong", hidden: true}
