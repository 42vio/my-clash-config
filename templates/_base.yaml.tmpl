# 2025/07/05 墨鱼 https://github.com/ddgksf2013/Profile/blob/master/ClashVergeforWindows.yaml  𝐡𝐭𝐭𝐩𝐬://𝐭.𝐦𝐞/𝐝𝐝𝐠𝐤𝐬𝐟𝟐𝟎𝟐𝟏
# https://github.com/Aethersailor/Custom_OpenClash_Rules/blob/main/cfg/yaml/Custom_Clash_Selfhosted_Provider_Fallback.yaml

# dns 泄漏解决原理
# https://v2ex.com/t/1137959
# https://github.com/clash-verge-rev/clash-verge-rev/discussions/2526
# https://blog.arisa.moe/blog/2025/250814-best-practice-of-anti-dns-leak/#24-dns


mixed-port: 7890     # HTTP 代理端口
allow-lan: true      # 允许局域网连接
bind-address: "*"    # 地址绑定
mode: rule           # 规则模式
log-level: info      # 日志级别
ipv6: false          # IPV6开关
external-controller: 127.0.0.1:9090

profile:
  store-selected: true
  store-fake-ip: true


dns:
  enable: true
  ipv6: false
  prefer-h3: false

  listen: 0.0.0.0:53 # dns 监听
  enhanced-mode: fake-ip
  use-system-hosts: false
  cache-algorithm: arc
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    # ===== 私有网络 =====
    - "geosite:private"
    - "+.lan"
    - "+.local"

    # ===== Windows 网络连通性检测 =====
    - "+.msftconnecttest.com"
    - "+.msftncsi.com"

    # ===== QQ / 微信快速登录 =====
    - "localhost.ptlogin2.qq.com"
    - "localhost.sec.qq.com"
    - "localhost.work.weixin.qq.com"

    # ===== STUN / 游戏主机 =====
    - "+.srv.nintendo.net"
    - "+.stun.playstation.net"
    - "+.xboxlive.com"
    - "xbox.*.microsoft.com"

    # ===== Battle.net =====
    # - "*.battlenet.com.cn"
    # - "*.battlenet.com"
    # - "*.blzstatic.cn"
    # - "*.battle.net"

    # ===== 按需启用 =====
    # - "+.push.apple.com"
    # - "+.market.xiaomi.com"

  # 用于解析 DNS 服务器自身域名
  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29

# ↓ 由 parts/ 注入（dns-balanced / dns-privacy）
{{ DNS_VARIANT }}

#========= 建立锚点 =========#
p:    &p    {type: http,     interval: 86400, health-check: {enable: true, url: http://www.gstatic.com/generate_204, interval: 1800}}   # 订阅 provider 基底
auto: &auto {type: url-test, url: http://www.google.com/generate_204, interval: 1800, tolerance: 50, use: [Subscribe]}                  # 自动测速组基底
sel:  &sel  {type: select}
fall: &fall {type: fallback}                                                                                                       # 普通手选组
usel: &usel {type: select,   use: [Subscribe]}                                                                                         # 手动切换（订阅全列）
a3:   &a3   {type: select,   proxies: [自动选择, 🇭🇰 香港节点, 🇯🇵 日本节点, 🇺🇲 美国节点, 🇨🇳 台湾节点, 🇸🇬 新加坡节点]}  # 加速线路全列表
g1:   &g1   {type: select,   proxies: [🎯 Direct, 加速线路]}                  # 直连优先 + 加速
g2:   &g2   {type: select,   proxies: [🎯 Direct, 加速线路]}                  # 媒体类
g3:   &g3   {type: select,   proxies: [加速线路, 🎯 Direct]}                  # 加速优先
c:    &c    {type: http,     behavior: classical, interval: 86400}                                                                     # classical 规则集基底

proxies:
{{ PRIVATE_PROXIES }}

proxy-providers:
  Subscribe:
    type: http
    url: '{{ SUBSCRIPTION_PROVIDER_URL }}'
    path: ./providers/Subscribe.yaml
    interval: 86400
    health-check:
      enable: true
      url: http://www.gstatic.com/generate_204
      interval: 1800

proxy-groups:
#节点分组（订阅按地区自动测速 / 手动切换）
