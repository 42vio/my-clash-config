{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "inbound-443",
      "listen": "0.0.0.0",
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "00000000-0000-4000-8000-000000000001",
            "flow": "xtls-rprx-vision",
            "email": "client-owner"
          },
          {
            "id": "00000000-0000-4000-8000-000000000002",
            "flow": "xtls-rprx-vision",
            "email": "client-member"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "www.example.com:443",
          "xver": 0,
          "serverNames": ["www.example.com"],
          "privateKey": "SYNTHETIC-private-key-base64url-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
          "shortIds": ["0123456789abcdef"],
          "settings": {
            "publicKey": "SYNTHETIC-public-key-base64url-BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB",
            "fingerprint": "chrome",
            "spiderX": "/"
          }
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls"]
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom"
    },
    {
      "tag": "block",
      "protocol": "blackhole"
    }
  ]
}
